[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore

# Optional pieces linked by other dotfiles modules; Git skips missing includes.
# (gh module: GitHub credential helper)
[include]
	path = ~/.config/git/gh.gitconfig

# Machine-local / identity configuration (GPG keys, email, work/personal overrides)
[include]
	path = ~/.gitconfig.local
